# TAVANA Studio - Environment Configuration Template
# ----------------------------------------------------
# AUTOMATED SECURE SECRETS MANAGEMENT:
# Secrets and API keys are configured securely via the AI Studio Secrets panel.
# The Secrets Gradle Plugin automatically compiles them into BuildConfig.
# Actual secrets must NEVER be committed to version control (.env is in .gitignore).
#
# Gemini API Key (for automated Gemini AI Vocal Coach & Music Analysis):
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Server-side AI Gateway Endpoint (Optional cloud proxy deployed on Cloud Functions / Cloud Run):
AI_GATEWAY_URL=https://gateway.tavana.studio/api/v1/ai
AI_GATEWAY_ENV=production


