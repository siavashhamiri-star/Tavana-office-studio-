# TAVANA Studio - Environment Configuration Template
# ----------------------------------------------------
# SECURITY NOTICE:
# Provider API keys (e.g. Gemini, OpenAI) MUST NEVER be embedded in the Android
# application client, BuildConfig, or client repository.
# All AI requests route strictly through the Secure AI Gateway.
#
# Server-side AI Gateway Endpoint (Deployed on Firebase Cloud Functions / Cloud Run):
AI_GATEWAY_URL=https://gateway.tavana.studio/api/v1/ai
AI_GATEWAY_ENV=production

